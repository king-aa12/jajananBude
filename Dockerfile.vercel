
# Vercel Container Runtime + Laravel 13 + FrankenPHP

# ==========================================
# STAGE 1: FRONTEND BUILD
# ==========================================
FROM node:22-bookworm-slim AS frontend

WORKDIR /app

COPY . .

RUN npm install --no-audit --no-fund \
    && npm run build


# ==========================================
# STAGE 2: LARAVEL + FRANKENPHP
# ==========================================
FROM dunglas/frankenphp:1-php8.3-bookworm

# Install PHP extensions
RUN install-php-extensions pdo_mysql intl zip opcache

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copy Laravel application
COPY . .

# Copy TiDB Cloud SSL certificate
# IMPORTANT: Must be inside the PHP runtime container
COPY certs/ca.pem /etc/ssl/certs/tidb-ca.pem

# Install Laravel dependencies
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-progress \
    --optimize-autoloader

# Copy frontend build
COPY --from=frontend /app/public/build ./public/build

# Prepare Laravel storage directories
RUN mkdir -p \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# Configure FrankenPHP
COPY Caddyfile /etc/frankenphp/Caddyfile

EXPOSE 3000

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
